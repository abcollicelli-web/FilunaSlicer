--- a/src/libslic3r/PrintConfig.cpp
+++ b/src/libslic3r/PrintConfig.cpp
@@
     if (this->has("wipe_tower_filament")) {
         // If invalid, replace with 0.
         int extruder      = this->opt<ConfigOptionInt>("wipe_tower_filament")->value;
-        int num_extruders = this->opt<ConfigOptionFloats>("nozzle_diameter")->size();
-        if (extruder < 0 || extruder > num_extruders)
-            this->option("wipe_tower_filament")->setInt(0);
+        // Loading CLI --load-settings can normalize the PROCESS before merging
+        // the separately loaded MACHINE. The process may define
+        // wipe_tower_filament yet not define nozzle_diameter. Never dereference
+        // a missing nozzle option. Validate again when the merged config
+        // contains printer nozzle metadata.
+        const auto* nozzles = this->opt<ConfigOptionFloats>("nozzle_diameter");
+        if (nozzles && nozzles->size() > 0) {
+            int num_extruders = int(nozzles->size());
+            if (extruder < 0 || extruder > num_extruders)
+                this->option("wipe_tower_filament")->setInt(0);
+        }
     }

